{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/project", "destination": "/", "type": 301 },
      { "source": "/project/**", "destination": "/", "type": 301 }
    ]
  }
}
